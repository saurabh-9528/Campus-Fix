# CampusFix Backend Environment Variables

# The secret key is required for JWT token generation. 
# NEVER commit the actual secret key to version control!
# Generate one using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=<generate-a-strong-random-secret>

# Comma-separated list of allowed frontend origins for CORS.
# For local development: http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Object storage configuration:
# Use "local" for local development/tests, and "s3" for persistent production storage (e.g., Cloudflare R2 / AWS S3).
STORAGE_BACKEND=local
# S3_BUCKET_NAME=campusfix-uploads
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<your-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-secret-access-key>
# S3_PREFIX=complaints
