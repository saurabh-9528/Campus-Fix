# CampusFix Backend Environment Variables

# The secret key is required for JWT token generation. 
# NEVER commit the actual secret key to version control!
# Generate one using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=<generate-a-strong-random-secret>

# Comma-separated list of allowed frontend origins for CORS.
# Use explicit origins (never '*' when credentials are enabled).
# For local development, include common Vite/React dev server origins:
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Database connection string (defaults to local SQLite if omitted).
# For PostgreSQL in production, use postgres:// or postgresql:// (normalized to postgresql+pg8000://).
# DATABASE_URL=postgresql://user:password@localhost:5432/campusfix

# Storage configuration:
# Use "local" for local development/tests.
# Use "db" for Render Free PostgreSQL BYTEA storage (note: Render Free DB has 1 GB cap and 30-day expiration; take periodic pg_dump backups).
# Use "disk" with PERSISTENT_DISK_PATH for Render Persistent Disk, or "s3" for S3-compatible object storage.
STORAGE_BACKEND=local
# Render Persistent Disk mount path (must be an absolute path matching the Render Disk Mount Path):
# PERSISTENT_DISK_PATH=/var/data/campusfix-uploads
# Optional S3-compatible object storage (only required when STORAGE_BACKEND=s3):
# S3_BUCKET_NAME=campusfix-uploads
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=<your-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-secret-access-key>
# S3_PREFIX=complaints
